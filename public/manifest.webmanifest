{
  "name": "calcRepo — Static developer calculator",
  "short_name": "calcRepo",
  "description": "Static, offline-capable developer calculator with basic, scientific, base, programmer, and coding tools.",
  "start_url": "/calcRepo/",
  "scope": "/calcRepo/",
  "id": "/calcRepo",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "./pwa/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./pwa/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
