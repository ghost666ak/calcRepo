{
  "name": "calc-repo",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "description": "Static developer calculator (basic, scientific, base conversion, programmer, coding toolbox).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && node scripts/generate-pwa-screenshots.mjs && node scripts/generate-precache-manifest.mjs",
    "build:pages": "tsc -b --noEmit && CALCREPO_OUTDIR=docs vite build && CALCREPO_OUTDIR=docs node scripts/generate-pwa-screenshots.mjs && CALCREPO_OUTDIR=docs node scripts/generate-precache-manifest.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "screenshots": "node scripts/generate-pwa-screenshots.mjs",
    "precache:manifest": "node scripts/generate-precache-manifest.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.36.0",
    "eslint-plugin-react-hooks": "^5.0.0-canary-7118f5dd7-20240705",
    "fast-check": "^4.9.0",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.5",
    "vitest": "^2.1.1"
  }
}
